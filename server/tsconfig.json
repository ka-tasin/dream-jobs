{
  "compilerOptions": {
    "target": "ESNext",
    "module": "node16",
    // "module": "commonjs",
    "moduleResolution": "node16",          
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./",
    // "baseUrl": ".",                     
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src/**/*", "prisma/**/*"]
}