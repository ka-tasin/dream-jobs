generator client {
  provider      = "prisma-client-js"
  output        = "./generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())

  firstName String
  lastName  String

  email      String        @unique
  role       Role          @default(USER)
  provider   AuthProvider? @default(CREDENTIALS)
  providerId String?       @default("")
  password   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  isEmailVerified     Boolean   @default(false)
  emailVerifyToken    String?
  resetPasswordToken  String?
  resetPasswordExpiry DateTime?
  isActive            Boolean   @default(true)
  lastLoginAt         DateTime?

  jobs         Job[]         @relation("UserJobs")
  applications Application[]
  savedJobs    SavedJob[]

  @@map("users")
}

model Job {
  id          String  @id @default(cuid())
  title       String
  description String
  role        String
  company     String
  location    String
  type        JobType
  experience  String?

  officeTime String

  salary    Float?
  salaryMax Float?
  currency  String @default("USD")

  postedAt  DateTime  @default(now())
  deadline  DateTime?
  createdBy String

  isActive  Boolean  @default(true)
  views     Int      @default(0)
  updatedAt DateTime @default(now()) @updatedAt

  creator      User          @relation("UserJobs", fields: [createdBy], references: [id], onDelete: Cascade)
  applications Application[]
  savedBy      SavedJob[]
  skills       String[]

  @@index([title])
  @@index([createdBy])
  @@index([type])
  @@index([location])
  @@index([salary])
  @@index([salaryMax])
  @@index([postedAt])
  @@index([deadline])
  @@map("jobs")
}

model Application {
  id          String    @id @default(cuid())
  userId      String
  jobId       String
  resumeUrl   String?
  coverLetter String?
  status      AppStatus @default(PENDING)
  appliedAt   DateTime  @default(now())
  reviewedAt  DateTime?
  reviewNote  String?
  updatedAt   DateTime  @default(now()) @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@index([jobId])
  @@index([userId])
  @@map("applications")
}

model SavedJob {
  id     String @id @default(cuid())
  userId String
  jobId  String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  savedAt   DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([userId, jobId])
  @@index([jobId])
  @@index([userId])
  @@map("saved_jobs")
}

enum JobType {
  FULL_TIME
  PART_TIME
  REMOTE
  HYBRID
  CONTRACT
  INTERNSHIP
  ONSITE
}

enum Role {
  USER
  ADMIN
  EMPLOYER
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
  FACEBOOK
}

enum AppStatus {
  PENDING
  REVIEWED
  ACCEPTED
  REJECTED
}
